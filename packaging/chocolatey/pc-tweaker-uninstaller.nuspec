    <packageSourceUrl>https://github.com/AurelioAvila/pc-tweaker-uninstaller/tree/master/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://pctweaker.app/uninstaller/</docsUrl>
    <bugTrackerUrl>https://github.com/AurelioAvila/pc-tweaker-uninstaller/issues</bugTrackerUrl>
  </metadata>
  <files>
    <file src="tools\*.ps1" target="tools" />
  </files>
</package>
